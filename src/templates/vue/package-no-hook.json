{
  "name": "$projectName",
  "version": "1.0.0",
  "description": "Vue template for front-end framework Swico",
  "main": "index.js",
  "scripts": {
    "start": "swico start",
    "build": "swico build",
    "build:analyze": "cross-env ANALYZE=true swico build",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,mjs,mts,vue} && prettier --write src/**/*.{js,jsx,ts,tsx,mjs,mts,vue,css,less,scss,json,html,md}"
  },

  "repository": {
    "type": "git",
    "url": "https://github.com/scw1997/swico.git"
  },
  "keywords": [
    "$projectName",
    "swico",
    "typescript",
    "vue",
    "javascript",
    "rsbuild",
    "rspack"
  ],
  "author": "scw",
  "license": "ISC",
  "dependencies": {
    "vue": "~3.5.34",
    "swico": "~3.1.0-beta.4"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "globals": "17.6.0",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "eslint-plugin-vue": "10.9.1",
    "typescript-eslint": "8.59.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "cross-env": "7.0.3",
    "@rsbuild/core": "~2.1.13",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
