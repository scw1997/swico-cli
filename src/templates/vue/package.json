{
  "name": "$projectName",
  "version": "1.0.0",
  "description": "Vue template for front-end framework Swico",
  "main": "index.js",
  "scripts": {
    "start": "swico start",
    "build": "swico build",
    "build:analyze": "cross-env ANALYZE=true swico build",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,mjs,mts,vue} && prettier --write src/**/*.{css,less,scss,json,html,md}",
    "husky:init": "npx husky init",
    "test": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,mjs,mts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,less,scss,json,html,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scw1997/swico.git"
  },
  "keywords": [
    "$projectName",
    "swico",
    "typescript",
    "vue",
    "javascript",
    "rsbuild"
  ],
  "author": "scw",
  "license": "ISC",
  "dependencies": {
    "vue": "~3.5.34",
    "swico": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "globals": "17.6.0",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "eslint-plugin-vue": "10.9.1",
    "typescript-eslint": "8.59.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "cross-env": "7.0.3",
    "husky": "9.0.10",
    "@commitlint/cli": "18.5.0",
    "@commitlint/config-conventional": "18.5.0",
    "lint-staged": "15.2.1",
    "@rsbuild/core": "^2.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
