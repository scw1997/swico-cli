{
  "name": "$projectName",
  "version": "1.0.0",
  "description": "React template for front-end framework Swico",
  "main": "index.js",
  "scripts": {
    "start": "swico start",
    "build": "swico build",
    "build:analyze": "cross-env ANALYZE=true swico build",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,mjs,mts} && prettier --write src/**/*.{mjs,mts,js,jsx,ts,tsx,css,less,scss,json,html,md}"
  },
  "keywords": [
    "$projectName",
    "swico",
    "typescript",
    "javascript",
    "react",
    "rsbuild"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/scw1997/swico.git"
  },
  "author": "scw",
  "license": "ISC",
  "dependencies": {
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "swico": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.18",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "cross-env": "7.0.3",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.2",
    "@rsbuild/core": "^2.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
